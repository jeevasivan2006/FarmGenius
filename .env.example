# FarmGenius – AI-Powered Farming Solution
# Environment Variables Configuration

# 1. Firebase Configuration (Optional if testing in guest mode; required for real Firebase Auth & Firestore)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# 2. Google Gemini API (Required for live Gemini AI inference; fallback agronomic engine active if not provided)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Weather API (Optional: OpenWeatherMap; Open-Meteo live global API is used as automatic real-data fallback)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
